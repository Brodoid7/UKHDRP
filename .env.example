TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Your main server ID. Required for modmail (DMs have no server) and gives instant slash-command updates.
GUILD_ID=your-server-id

# Comma-separated Discord user IDs of the bot owners (full control of staff/gban/blacklist).
OWNER_IDS=your-user-id
# true = register slash commands only in GUILD_ID (instant, for testing). Default: global.
GUILD_ONLY=false
